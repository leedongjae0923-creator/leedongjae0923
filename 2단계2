def check_api_keys() -> Tuple[str, str]:
    """API 키 존재 여부 확인 및 가져오기"""
    openai_key = os.getenv("OPENAI_API_KEY")
    kakao_key = os.getenv("KAKAO_REST_API_KEY")

    if not openai_key or not kakao_key:
        print("[오류] API 키가 설정되지 않았습니다.")
        print("'.env' 파일을 작성하거나 아래 환경변수를 설정해주세요.")
        print("  - OPENAI_API_KEY")
        print("  - KAKAO_REST_API_KEY")
        print("\n자세한 방법은 README.md를 참조하세요.")
        sys.exit(1)

    return openai_key, kakao_key


def validate_date(date_text: str) -> str:
    """YYYY-MM-DD 날짜 형식 검증"""
    try:
        datetime.datetime.strptime(date_text, "%Y-%m-%d")
        return date_text
    except ValueError:
        print(f"[오류] 올바르지 않은 날짜 형식입니다: '{date_text}'")
        print("사용법: python main.py -date YYYY-MM-DD (예: 2026-05-15)")
        sys.exit(1)


