<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>AI 데일리 마인드 케어</title>
  <style>
    /* CSS 스타일링 */
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Noto Sans KR', sans-serif; line-height: 1.6; background-color: #f8f9fa; color: #333; }
    .container { max-width: 800px; margin: 0 auto; padding: 20px; }

    header { background: #4a90e2; color: #fff; padding: 1rem 0; }
    header .container { display: flex; justify-content: space-between; align-items: center; }
    nav ul { display: flex; list-style: none; gap: 15px; }
    nav a { color: #fff; text-decoration: none; font-weight: bold; }
    nav a.active { text-decoration: underline; }

    .page-section { display: none; background: #fff; padding: 25px; border-radius: 10px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); margin-top: 20px; }
    .page-section.active { display: block; }

    textarea { width: 100%; height: 120px; padding: 10px; margin: 10px 0; border: 1px solid #ccc; border-radius: 5px; resize: vertical; }
    .api-input { width: 100%; padding: 10px; margin: 5px 0 15px; border: 1px solid #ccc; border-radius: 5px; }
    .btn-primary { background: #4a90e2; color: white; border: none; padding: 10px 20px; border-radius: 5px; cursor: pointer; font-size: 1rem; }
    .btn-primary:disabled { background: #aaa; cursor: not-allowed; }

    .hidden { display: none; }
    .error-box { background: #ffe6e6; color: #d9534f; padding: 10px; border-radius: 5px; margin-top: 15px; }
    .result-box { background: #eef7ee; padding: 15px; border-radius: 5px; margin-top: 15px; white-space: pre-line; }

    .loading-box { text-align: center; margin-top: 15px; }
    .spinner { border: 4px solid #f3f3f3; border-top: 4px solid #4a90e2; border-radius: 50%; width: 30px; height: 30px; animation: spin 1s linear infinite; margin: 0 auto 10px; }
    @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }

    /* 모바일 반응형 Breakpoint */
    @media (max-width: 600px) {
      header .container { flex-direction: column; gap: 10px; text-align: center; }
      .container { padding: 10px; }
    }
  </style>
</head>
<body>
  <!-- 헤더 & SPA 네비게이션 -->
  <header>
    <div class="container">
      <h1>🧠 MindCare AI</h1>
      <nav>
        <ul>
          <li><a href="#about" class="nav-link active">서비스 소개</a></li>
          <li><a href="#care" class="nav-link">AI 고민 상담</a></li>
          <li><a href="#faq" class="nav-link">FAQ</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <main class="container">
    <!-- 섹션 1: 서비스 소개 -->
    <section id="about" class="page-section active">
      <h2>마음의 짐을 덜어놓는 공간</h2>
      <p style="margin-top: 10px;">혼자 고민하기 힘든 일들이 있으신가요? AI 상담사가 따뜻한 공감과 현실적인 미션을 제안합니다.</p>
      <br>
      <button onclick="navigateTo('care')" class="btn-primary">상담 시작하기</button>
    </section>

    <!-- 섹션 2: AI 고민 상담 -->
    <section id="care" class="page-section">
      <h2>AI 고민 상담소</h2>
      <form id="ai-form" style="margin-top: 15px;">
        <label for="api-key"><strong>OpenAI API Key</strong> (sk-...)</label>
        <input type="password" id="api-key" class="api-input" placeholder="OpenAI API 키를 입력하세요" required>

        <label for="user-text"><strong>오늘 어떤 고민이 있으신가요?</strong></label>
        <textarea id="user-text" placeholder="오늘 있었던 일이나 마음속 고민을 10자 이상 편하게 작성해보세요."></textarea>
        
        <button type="submit" id="submit-btn" class="btn-primary">AI 조언 구하기</button>
      </form>

      <!-- 에러 처리 메시지 박스 -->
      <div id="error-message" class="error-box hidden"></div>

      <!-- 로딩 표시 -->
      <div id="loading" class="loading-box hidden">
        <div class="spinner"></div>
        <p>AI 상담사가 당신의 고민을 읽고 답변을 작성 중입니다...</p>
      </div>

      <!-- 결과 출력 박스 -->
      <div id="result-box" class="result-box hidden">
        <h3>AI 상담사의 답변</h3>
        <p id="result-content" style="margin-top: 10px;"></p>
      </div>
    </section>

    <!-- 섹션 3: FAQ -->
    <section id="faq" class="page-section">
      <h2>자주 묻는 질문</h2>
      <div style="margin-top: 15px;">
        <strong>Q. 입력한 개인정보나 API 키가 저장되나요?</strong>
        <p>아닙니다. 모든 로직은 사용자의 브라우저 내에서 직접 실행되며 서버에 별도로 데이터가 저장되지 않습니다.</p>
      </div>
      <div style="margin-top: 15px;">
        <strong>Q. 답변이 생성되지 않을 땐 어떻게 하나요?</strong>
        <p>API 키가 올바른지 확인하시거나 고민 내용을 10자 이상 작성했는지 확인해 주세요.</p>
      </div>
    </section>
  </main>

  <script>
    // SPA 단일 페이지 네비게이션 제어
    function navigateTo(sectionId) {
      document.querySelectorAll('.page-section').forEach(sec => sec.classList.remove('active'));
      document.querySelectorAll('.nav-link').forEach(link => link.classList.remove('active'));

      const targetSection = document.getElementById(sectionId);
      if (targetSection) targetSection.classList.add('active');

      const activeLink = document.querySelector(`nav a[href="#${sectionId}"]`);
      if (activeLink) activeLink.classList.add('active');
    }

    document.querySelectorAll('nav a').forEach(link => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        const target = link.getAttribute('href').replace('#', '');
        navigateTo(target);
      });
    });

    // AI API 직접 호출 및 실패 처리 로직
    document.getElementById('ai-form').addEventListener('submit', async (e) => {
      e.preventDefault();

      const apiKey = document.getElementById('api-key').value.trim();
      const textInput = document.getElementById('user-text').value.trim();
      const errorBox = document.getElementById('error-message');
      const loadingBox = document.getElementById('loading');
      const resultBox = document.getElementById('result-box');
      const resultContent = document.getElementById('result-content');
      const submitBtn = document.getElementById('submit-btn');

      // 초기화
      errorBox.classList.add('hidden');
      resultBox.classList.add('hidden');

      // 1. 예외 처리: 빈값/글자수 미달 검증
      if (!apiKey) {
        errorBox.textContent = 'OpenAI API 키를 입력해 주세요.';
        errorBox.classList.remove('hidden');
        return;
      }

      if (!textInput || textInput.length < 10) {
        errorBox.textContent = '고민 내용은 최소 10자 이상 작성해 주세요.';
        errorBox.classList.remove('hidden');
        return;
      }

      // UI 로딩 상태 적용
      loadingBox.classList.remove('hidden');
      submitBtn.disabled = true;

      try {
        // OpenAI API 직접 호출 (Fetch)
        const response = await fetch('https://api.openai.com/v1/chat/completions', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${apiKey}`
          },
          body: JSON.stringify({
            model: 'gpt-4o-mini',
            messages: [
              { role: 'system', content: '너는 따뜻하고 전문적인 심리 상담사야. 사용자의 고민을 듣고 [공감의 말], [조언], [오늘의 실천 미션] 3가지 구성을 나누어 다정하게 답해줘.' },
              { role: 'user', content: textInput }
            ],
            max_tokens: 500
          })
        });

        const data = await response.json();

        // 2. 예외 처리: HTTP 에러 / API 오류
        if (!response.ok) {
          throw new Error(data.error?.message || 'API 호출 중 오류가 발생했습니다.');
        }

        // 결과 출력
        resultContent.textContent = data.choices[0].message.content;
        resultBox.classList.remove('hidden');

      } catch (err) {
        // 3. 예외 처리: 네트워크/타임아웃 오류
        errorBox.textContent = err.message || '요청이 원활하지 않습니다. API 키나 네트워크 상태를 확인해 주세요.';
        errorBox.classList.remove('hidden');
      } finally {
        loadingBox.classList.add('hidden');
        submitBtn.disabled = false;
      }
    });
  </script>
</body>
</html>
